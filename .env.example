# LLM Provider: "openai" or "gemini"
LLM_PROVIDER=openai
# Default matches the thesis evaluation; change for reproductions on other models.
LLM_MODEL=gpt-5.5
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# OpenAI (or OpenAI-compatible API)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=              # Custom endpoint, e.g. https://your-proxy.com/v1

# Gemini
GEMINI_API_KEY=AI...
GEMINI_BASE_URL=              # Custom endpoint, e.g. https://your-proxy.com

# Execution
# Thesis runs used 600s; lower the timeout to speed up smaller-scale reproductions.
TASK_TIMEOUT_S=600
RUNS_PER_TASK=3

# Data path (override if needed)
# DATA_PATH=/path/to/bpi2017/
